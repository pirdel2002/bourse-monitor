PORT=3000
HOST_PORT=3000
APP_NAME=پایش خودکار بورس
ADMIN_TOKEN=CHANGE_TO_A_LONG_RANDOM_VALUE
APP_ENCRYPTION_KEY=CHANGE_TO_A_DIFFERENT_LONG_RANDOM_VALUE
POLL_INTERVAL_SECONDS=15
MARKET_CACHE_SECONDS=150
RETENTION_DAYS=90
EVENT_RETENTION_DAYS=3
MARKET_TIMEZONE=Asia/Tehran
MARKET_PREOPEN_START=08:45
MARKET_START=09:00
MARKET_END=12:30
# Percentage of the normal planned position used for EARLY_ENTRY (1..100).
OPPORTUNITY_EARLY_ENTRY_POSITION_PCT=50
# Opportunity v3 setup/entry routing. All values are percentages except the
# range-compression ratio. They only affect local candle calculations.
OPPORTUNITY_PRIOR_IMPULSE_MIN_GAIN_PCT=12
OPPORTUNITY_PRIOR_IMPULSE_RETURN20_PCT=8
OPPORTUNITY_HEALTHY_CORRECTION_MAX_PCT=12
OPPORTUNITY_EMA20_TOLERANCE_PCT=3
OPPORTUNITY_PULLBACK_ZONE_PCT=1
OPPORTUNITY_PULLBACK_MAX_PCT=2
OPPORTUNITY_BREAKOUT_MAX_PCT=2
OPPORTUNITY_RANGE_COMPRESSION_RATIO=0.8

# Start without consuming real API quota. Change to brsapi after configuration.
DATA_PROVIDER=mock
BRS_API_KEY=
BRS_BASE_URL=https://Api.BrsApi.ir
BRS_ALL_SYMBOLS_PATH=/Tsetmc/AllSymbols.php
BRS_ALL_SYMBOLS_TYPE=1
BRS_SYMBOL_PATH=/Tsetmc/Symbol.php
BRS_INDEX_PATH=/Tsetmc/Index.php
BRS_CANDLE_PATH=/Tsetmc/Candlestick.php
BRS_API_KEY_HEADER=X-API-Key
BRS_API_KEY_QUERY=key
BRS_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36

# Persistent safety limits. Set these to the exact limits shown in the BRSAPI plan.
BRS_GLOBAL_5MIN_LIMIT=300
BRS_ALL_SYMBOLS_DAILY_LIMIT=100
BRS_ALL_SYMBOLS_5MIN_LIMIT=2
BRS_SYMBOL_DAILY_LIMIT=10
BRS_SYMBOL_5MIN_LIMIT=2
BRS_INDEX_DAILY_LIMIT=100
BRS_INDEX_5MIN_LIMIT=2
BRS_CANDLE_DAILY_LIMIT=10
BRS_CANDLE_5MIN_LIMIT=2

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=/app/data/monitor.db

# Optional public HTTPS access without opening ports 80/443.
# In Cloudflare Tunnel, set the public hostname service to http://app:3000.
CLOUDFLARE_TUNNEL_TOKEN=
